# Copy to .env and fill in real values. Never commit .env.

# --- Node backend (server.js) ---
PORT=3000
# Public URL the app is served from
PUBLIC_BASE_URL=http://localhost:3000
FINNHUB_API_KEY=your_finnhub_key
MONGO_URL=mongodb://localhost:27017/niveshpath
JWT_SECRET=change_me_to_a_long_random_string
# Optional: Redis cache for stock quotes (falls back to in-memory cache)
REDIS_URL=redis://localhost:6379
# URL of the Python AI service
AI_SERVICE_URL=http://localhost:8001
# Shared secret between the backend and the AI service (same value on both; leave empty to disable the check).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_TOKEN=
# --- Postgres ledger (Phase 3): cash accounts and trades ---
# mongo (default: today's ledger in MongoDB) or postgres (needs DATABASE_URL; the server refuses to start without it)
LEDGER_BACKEND=mongo
# Pooled connection used by the app. Neon: the "Pooled connection" string with &pgbouncer=true added.
# docker compose sets these to its own Postgres service; locally: postgresql://postgres@localhost:5432/nivesh
DATABASE_URL=
# Direct (non-pooled) connection, used only by `npx prisma migrate deploy`. Neon: the "Direct connection" string.
DIRECT_URL=
# 1 = trading, reset and account deletion answer 503 "paused for a few minutes" (reads keep working). Cutover only.
# LEDGER_MAINTENANCE=1
# Integration tests (tests/ledger.pg.test.js) run only when this points at a migrated, disposable database:
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/nivesh_test
# Optional: Sentry error tracking (GitHub Student Pack)
SENTRY_DSN=
# Optional: email for the contact form via Resend (https://resend.com, free tier). Messages are always
# saved to MongoDB; with these set they are also emailed to CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
MAIL_FROM=Nivesh-Path <onboarding@resend.dev>
# Optional: roll React pages back to the legacy HTML pages, comma separated (e.g. /markets,/stock). Empty = all React.
REACT_DISABLED=
# Automated browser tests only: made-up stock prices, no Finnhub key needed. Refused when NODE_ENV=production.
# FAKE_MARKET_DATA=1

# --- Python AI service (ai-service/) ---
ANTHROPIC_API_KEY=your_anthropic_key
CLAUDE_MODEL=claude-opus-5-5
CHROMA_PERSIST_DIR=./chroma_data
# On boot the AI service rebuilds ChromaDB from every user's trades. With WEB_INTERNAL_URL and AI_INTERNAL_TOKEN set
# it reads them from the web service's /internal API (works for both ledgers); otherwise from MongoDB directly.
WEB_INTERNAL_URL=http://localhost:3000
# It also reads MONGO_URL (above) and stores behavioral-pattern results there. Optional database name override:
# MONGO_DB_NAME=niveshpath
