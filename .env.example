# Copy to .env and fill in real values. Never commit .env.

# --- Node backend (server.js) ---
PORT=3000
# Public URL the app is served from
PUBLIC_BASE_URL=http://localhost:3000
FINNHUB_API_KEY=your_finnhub_key
MONGO_URL=mongodb://localhost:27017/niveshpath
JWT_SECRET=change_me_to_a_long_random_string
# Optional: Redis cache for stock quotes (falls back to in-memory cache)
REDIS_URL=redis://localhost:6379
# URL of the Python AI service
AI_SERVICE_URL=http://localhost:8001
# Optional: Sentry error tracking (GitHub Student Pack)
SENTRY_DSN=

# --- Python AI service (ai-service/) ---
ANTHROPIC_API_KEY=your_anthropic_key
CLAUDE_MODEL=claude-opus-5-5
CHROMA_PERSIST_DIR=./chroma_data
