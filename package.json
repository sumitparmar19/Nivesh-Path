{
  "name": "nivesh-path",
  "version": "2.0.0",
  "description": "Nivesh-Path: AI-powered stock investing platform (Node/Express backend + FastAPI AI advisor)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "investing",
    "stocks",
    "ai",
    "claude",
    "express"
  ],
  "author": "Sumit Parmar",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^11.4.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.13.2",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/psk/",
      "/public/",
      "/ai-service/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/psk/",
      "<rootDir>/public/",
      "<rootDir>/ai-service/"
    ]
  }
}
